# Local development environment variables
# Copy to .env and fill in your values — never commit .env to git

# Set to "true" to run without a HANA instance (data stored in-process, resets on restart)
USE_MEMORY_STORE=false

# HANA Cloud connection (only needed when USE_MEMORY_STORE=false)
HANA_HOST=your-hana-host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=YOUR_DB_USER
HANA_PASSWORD=YOUR_DB_PASSWORD

# Optional: override Flask secret key
# SECRET_KEY=change-me
